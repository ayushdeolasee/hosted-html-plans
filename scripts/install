#!/usr/bin/env bash
# install — developer convenience wrapper (you have the repo checked out).
#
# End users do NOT use this file. They run the generated installer directly:
#   U=https://raw.githubusercontent.com/ayushdeolasee/hosted-html-plans/main/install.sh
#   curl -fsSL $U | bash -s -- --client    # push-plan + agent skill picker
#   curl -fsSL $U | bash -s -- --server    # the plans service
#
# This wrapper regenerates install.sh from your working copy first, then runs
# it — so what you install is exactly what ships, including any uncommitted
# edits to scripts/push-plan or the HTML plans SKILL.md.
#
# Usage:
#   scripts/install [--url URL] [--skills-only] [--cli-only]
#   scripts/install --server [--binary PATH] [--print] [...]
#
# Any other flags are passed straight through to install.sh.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

ARGS=()
MODE=""

while [ $# -gt 0 ]; do
  case "$1" in
    --url)     ARGS+=(--url "${2:?--url needs a URL}"); shift 2 ;;
    --client)  MODE="client"; shift ;;
    --server)  MODE="server"; shift ;;
    -h|--help) sed -n '2,17p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *)         ARGS+=("$1"); shift ;;
  esac
done

# Always regenerate first so we're testing exactly what ships. When the server
# half is requested, install the binary we just built from this checkout rather
# than fetching a release — the whole point of the dev wrapper is local edits.
"$ROOT/scripts/build-installer" >/dev/null
export PLANS_SKILLS_SOURCE="$ROOT"

if [ "$MODE" = "server" ]; then
  if [ ! -x "$ROOT/plans" ]; then
    echo "install: no ./plans binary — run 'make build' first" >&2
    exit 1
  fi
  exec bash "$ROOT/install.sh" --server --binary "$ROOT/plans" "${ARGS[@]+"${ARGS[@]}"}"
fi

exec bash "$ROOT/install.sh" --client "${ARGS[@]+"${ARGS[@]}"}"
