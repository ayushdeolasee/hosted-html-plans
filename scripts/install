#!/usr/bin/env bash
# install — developer convenience wrapper (you have the repo checked out).
#
# End users do NOT use this file. They either:
#   curl -fsSL <install-url> | bash          # installs the push-plan command
#   npx skills add push-plan                 # installs the Claude Code skill
#
# This wrapper just runs the generated installer against your working copy and
# additionally links the skills into ~/.claude/skills so you can test edits
# without publishing.
#
# Usage:
#   scripts/install [--url URL] [--skills-only] [--cli-only]

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SKILLS_DIR="${CLAUDE_SKILLS_DIR:-$HOME/.claude/skills}"

URL=""
DO_CLI=1
DO_SKILLS=1

while [ $# -gt 0 ]; do
  case "$1" in
    --url)         URL="${2:?--url needs a URL}"; shift 2 ;;
    --skills-only) DO_CLI=0; shift ;;
    --cli-only)    DO_SKILLS=0; shift ;;
    -h|--help)     sed -n '2,14p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "install: unknown option: $1" >&2; exit 1 ;;
  esac
done

# Always regenerate first so we're testing exactly what ships.
"$ROOT/scripts/build-installer" >/dev/null

if [ "$DO_CLI" -eq 1 ]; then
  if [ -n "$URL" ]; then
    bash "$ROOT/install.sh" --url "$URL"
  else
    bash "$ROOT/install.sh"
  fi
fi

if [ "$DO_SKILLS" -eq 1 ]; then
  mkdir -p "$SKILLS_DIR"
  for skill in push-plan implement-plan; do
    [ -d "$ROOT/skill/$skill" ] || continue
    rm -rf "${SKILLS_DIR:?}/$skill"
    cp -R "$ROOT/skill/$skill" "$SKILLS_DIR/$skill"
    [ -f "$SKILLS_DIR/$skill/push-plan" ] && chmod +x "$SKILLS_DIR/$skill/push-plan"
    echo "installed  $SKILLS_DIR/$skill"
  done
fi
